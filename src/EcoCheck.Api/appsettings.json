{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "ReverseProxy": {
    "Enabled": true
  },
  "RateLimiting": {
    "SubmitPermitLimit": 5,
    "SubmitWindowMinutes": 10,
    "ReadPermitLimit": 60,
    "ReadWindowSeconds": 60
  }
}
